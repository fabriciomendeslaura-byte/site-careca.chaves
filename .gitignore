# Dependências — reinstaladas com `npm install`, nunca versionadas
node_modules/

# Saída de build — gerada a partir do código, não é fonte
dist/
.astro/
.vercel/

# Variáveis de ambiente (nenhuma hoje, mas o dia que houver não pode vazar)
.env
.env.*
!.env.example

# Sistema operacional e editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Imagens originais da IA: 4 a 8 MB cada, quase 50 MB no total.
# Ficam no disco como material de origem; o que vai para o site sao as
# versoes otimizadas em site/public/imagens, geradas por preparar-imagens.cjs
_material/imagens-geradas/
