---
/**
 * Logotipo da marca.
 *
 * Feito com texto e SVG, nao com imagem: fica nitido em qualquer tela, pesa
 * zero kB a mais e o nome do negocio vira texto de verdade — que o Google le
 * e o leitor de tela anuncia.
 *
 * O tamanho vem do `font-size` do elemento raiz, entao o conjunto inteiro
 * cresce junto, sem precisar de uma medida para cada parte.
 */

interface Props {
  /** Tamanho em pixels da altura da tipografia. */
  tamanho?: number;
  /** `linha` ocupa menos altura — serve a header baixo e rodapé. */
  variante?: 'empilhado' | 'linha';
  class?: string;
}

const { tamanho = 26, variante = 'empilhado', class: classe = '' } = Astro.props;
---

<a
  href="/"
  class:list={['logo', variante === 'linha' && 'logo--linha', classe]}
  style={`font-size:${tamanho}px`}
  aria-label="Careca Chaves — página inicial"
>
  <svg
    class="logo__chave"
    viewBox="0 0 64 64"
    fill="none"
    stroke="currentColor"
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="21" cy="32" r="11" />
    <path d="M32 32h25" />
    <path d="M47 32v9" />
    <path d="M57 32v6" />
  </svg>

  <span class="logo__texto">
    <span class="logo__careca">Careca</span>
    <span class="logo__chaves">Chaves</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    text-decoration: none;
    line-height: 1;
  }

  .logo__chave {
    width: 1.75em;
    height: 1.75em;
    color: var(--color-azul);
    flex: none;
  }

  /* line-height precisa ser >= 1 por causa do degradê em `background-clip: text`:
     o fundo só é pintado dentro da caixa da linha, então letra mais alta que a
     caixa fica sem tinta e parece cortada. O aperto visual entre as duas linhas
     vem do gap negativo, que move a caixa inteira sem encolher ela. */
  .logo__texto {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  .logo__chaves {
    margin-top: -0.22em;
  }

  .logo--linha .logo__texto {
    flex-direction: row;
    align-items: baseline;
    gap: 0.26em;
  }

  .logo--linha .logo__chaves {
    margin-top: 0;
  }

  /* Degradê prata vindo da arte original dele, sem o contorno triplo —
     que é bonito em post do Instagram e borra quando reduz para o header. */
  .logo__careca {
    font-size: 1em;
    letter-spacing: 0.02em;
    background: linear-gradient(180deg, #ffffff 42%, #c9d4e2);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .logo__chaves {
    font-size: 1em;
    letter-spacing: 0.06em;
    font-style: italic;
    color: var(--color-azul);
  }

  .logo:hover .logo__chave {
    color: var(--color-azul-brilho);
  }
</style>
