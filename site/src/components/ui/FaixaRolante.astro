---
/**
 * Faixa que desliza sem parar, com os bairros atendidos.
 *
 * Cumpre tres papeis de uma vez: da movimento ao site, repete a cobertura que
 * o visitante quer confirmar e deixa os nomes de bairro no HTML — o que ajuda
 * quem procura por "chaveiro em Ipanema".
 *
 * A lista e escrita duas vezes porque a animacao desloca exatamente metade da
 * largura: ao terminar, a segunda copia ja esta onde a primeira comecou, e o
 * ciclo reinicia sem salto visivel.
 */
const itens = [
  'Copacabana',
  'Ipanema',
  'Leblon',
  'Arpoador',
  'Leme',
  'Botafogo',
  'Flamengo',
  'Barra da Tijuca',
  'Centro',
  'Laranjeiras',
  'Jardim Botânico',
  'Gávea',
  'Lagoa',
  'Tijuca',
  'São Conrado',
  'Humaitá',
];
---

<div class="faixa" role="presentation">
  <div class="faixa__trilho">
    {
      [0, 1].map(() => (
        <ul class="faixa__lista" aria-hidden="true">
          {itens.map((item) => (
            <li>
              {item}
              <span class="faixa__ponto" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .faixa {
    overflow: hidden;
    border-block: 1px solid var(--color-borda);
    background: #090c11;
    /* Esmaece nas pontas para a faixa não parecer cortada na marra. */
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }

  .faixa__trilho {
    display: flex;
    width: max-content;
    animation: deslizar 42s linear infinite;
  }

  .faixa:hover .faixa__trilho {
    animation-play-state: paused;
  }

  .faixa__lista {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .faixa__lista li {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    padding: 15px 0;
    padding-right: 26px;
    font-family: var(--font-display);
    font-size: 1.04rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-texto-fraco);
    white-space: nowrap;
  }

  .faixa__ponto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-azul);
    flex: none;
  }

  @keyframes deslizar {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .faixa__trilho {
      animation: none;
    }
  }
</style>
