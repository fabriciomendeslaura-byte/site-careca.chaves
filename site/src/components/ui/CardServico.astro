---
import Icone from './Icone.astro';
import { linkWhatsApp } from '../../data/negocio';
import { conteudoServicos } from '../../data/conteudo';
import type { Servico } from '../../data/servicos';

interface Props {
  servico: Servico;
}

const { servico } = Astro.props;

/* Nem todo serviço tem página própria ainda. Enquanto não tiver, o card leva
   direto ao WhatsApp em vez de apontar para uma rota que não existe. */
const pagina = conteudoServicos[servico.id];
---

<article class:list={['servico', servico.destaque && 'servico--destaque', 'revelar']}>
  <!-- A arte do card é desenhada em CSS e o ícone fica por baixo da foto.
       Se a imagem não existir ou demorar, o card continua bonito e legível —
       nunca aparece retângulo cinza quebrado. -->
  <div class="servico__arte">
    <div class="servico__brilho" aria-hidden="true"></div>
    <Icone nome={servico.icone} tamanho={servico.destaque ? 72 : 56} class="servico__icone" />
    <!-- width e height declarados reservam o espaço antes de a imagem chegar:
         sem eles o navegador desenha o placeholder dele no lugar e o layout
         pula quando a foto carrega. -->
    <img
      class="servico__foto"
      src={servico.imagem}
      alt={servico.imagemAlt}
      width="1040"
      height="780"
      loading="lazy"
      decoding="async"
      onerror="this.remove()"
    />
  </div>

  <div class="servico__corpo">
    <p class="servico__gancho">{servico.gancho}</p>
    <h3 class="servico__titulo">{servico.titulo}</h3>
    <p class="servico__descricao">{servico.descricao}</p>

    <div class="servico__acoes">
      {
        pagina && (
          <a href={`/servicos/${pagina.slug}`} class="servico__link">
            Saiba como funciona
            <Icone nome="seta" tamanho={17} />
          </a>
        )
      }
      <a
        href={linkWhatsApp(servico.mensagem)}
        class:list={['servico__link', pagina && 'servico__link--secundario']}
        target="_blank"
        rel="noopener"
      >
        Falar no WhatsApp
        <Icone nome="seta" tamanho={17} />
      </a>
    </div>
  </div>
</article>

<style>
  .servico {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(165deg, var(--color-superficie-alta), var(--color-superficie));
    border: 1px solid var(--color-borda);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .servico:hover {
    border-color: var(--color-borda-viva);
    transform: translateY(-4px);
    box-shadow: 0 24px 50px -28px rgb(0 0 0 / 0.9);
  }

  /* --- Arte do topo ------------------------------------------------------ */
  .servico__arte {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(80% 90% at 50% 110%, rgb(30 144 255 / 0.22), transparent 70%),
      linear-gradient(170deg, #141b25, #0e131a);
    border-bottom: 1px solid var(--color-borda);
    overflow: hidden;
  }

  .servico__icone {
    position: relative;
    z-index: 2;
    color: var(--color-azul-brilho);
    opacity: 0.9;
    transition: transform 0.3s ease;
  }

  .servico:hover .servico__icone {
    transform: scale(1.08);
  }

  .servico__brilho {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(30 144 255 / 0.3), transparent 68%);
    filter: blur(28px);
    transition: opacity 0.3s ease;
    opacity: 0.75;
  }

  .servico:hover .servico__brilho {
    opacity: 1;
  }

  /* A foto cobre a arte quando existe; o ícone fica de reserva por baixo.
     Precisa ser 100% opaca: com opacidade menor, o ícone de reserva aparece
     através dela como um fantasma — z-index controla ordem, não visibilidade. */
  .servico__foto {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .servico:hover .servico__foto {
    transform: scale(1.04);
  }

  /* Véu escuro por cima da foto, para ela pertencer à paleta do site. É assim
     que se escurece imagem: camada acima dela, nunca opacidade nela. */
  .servico__arte::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(10 12 16 / 0.1) 40%, rgb(10 12 16 / 0.55));
  }

  /* --- Texto ------------------------------------------------------------- */
  .servico__corpo {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 24px 22px 26px;
    flex: 1;
  }

  .servico__gancho {
    margin: 0;
    color: var(--color-ambar);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .servico__titulo {
    margin: 0;
    font-size: 1.42rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .servico__descricao {
    margin: 0;
    color: var(--color-texto-suave);
    font-size: 0.99rem;
    flex: 1;
  }

  .servico__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 10px;
  }

  .servico__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-azul-brilho);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.96rem;
  }

  /* Quando há página do serviço, ela é o caminho principal e o WhatsApp vira
     a opção secundária — dois links com o mesmo peso não guiam ninguém. */
  .servico__link--secundario {
    color: var(--color-texto-fraco);
    font-weight: 600;
  }

  .servico__link--secundario:hover {
    color: var(--color-texto-suave);
  }

  .servico__link :global(svg) {
    transition: transform 0.2s ease;
  }

  .servico__link:hover :global(svg) {
    transform: translateX(4px);
  }

  /* --- Destaque ---------------------------------------------------------- */
  /* O serviço de maior valor ocupa duas colunas e ganha moldura azul.
     Hierarquia visual é o que diz ao olho por onde começar. */
  .servico--destaque {
    border-color: rgb(30 144 255 / 0.42);
  }

  .servico--destaque .servico__titulo {
    font-size: 1.68rem;
  }

  @media (min-width: 760px) {
    .servico--destaque {
      grid-column: span 2;
      flex-direction: row;
    }

    .servico--destaque .servico__arte {
      aspect-ratio: auto;
      flex: 1 1 46%;
      border-bottom: none;
      border-right: 1px solid var(--color-borda);
    }

    .servico--destaque .servico__corpo {
      flex: 1 1 54%;
      justify-content: center;
      padding: 32px 30px;
    }
  }
</style>
