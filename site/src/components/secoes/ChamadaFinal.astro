---
import BotaoLigar from '../ui/BotaoLigar.astro';
import BotaoZap from '../ui/BotaoZap.astro';
import RelogioAoVivo from '../ui/RelogioAoVivo.astro';
---

<section class="chamada" id="contato">
  <div class="chamada__fundo" aria-hidden="true"></div>

  <div class="area chamada__interno revelar">
    <RelogioAoVivo />

    <h2 class="chamada__titulo">Tá na porta<br />esperando até agora?</h2>

    <p class="chamada__texto">
      Liga. Eu atendo. Quanto antes você falar comigo, mais cedo você entra em casa.
    </p>

    <div class="chamada__acoes">
      <BotaoLigar texto="Ligar agora" comNumero class="chamada__botao" />
      <BotaoZap texto="Chamar no WhatsApp" class="chamada__botao" />
    </div>
  </div>
</section>

<style>
  .chamada {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--color-borda);
  }

  .chamada__fundo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(70% 110% at 50% 0%, rgb(255 122 26 / 0.16), transparent 62%),
      radial-gradient(90% 120% at 50% 110%, rgb(30 144 255 / 0.2), transparent 60%),
      #0b0f15;
  }

  .chamada__interno {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    padding-block: clamp(68px, 10vw, 118px);
  }

  .chamada__titulo {
    margin: 0;
    font-size: clamp(2.3rem, 7vw, 4.2rem);
    text-transform: uppercase;
    line-height: 1;
    background: linear-gradient(170deg, #ffffff 40%, #9fb3cc);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .chamada__texto {
    margin: 0;
    color: var(--color-texto-suave);
    font-size: clamp(1.02rem, 2.3vw, 1.18rem);
    max-width: 48ch;
  }

  .chamada__acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
    width: 100%;
  }

  .chamada__botao {
    flex: 1 1 auto;
    min-width: 214px;
  }

  @media (min-width: 700px) {
    .chamada__botao {
      flex: 0 0 auto;
      min-width: 0;
    }
  }
</style>
